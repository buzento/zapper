{
  "openapi": "3.1.1",
  "info": {
    "title": "Payments API",
    "version": "v1"
  },
  "paths": {
    "/v1/payments": {
      "post": {
        "tags": [
          "payments"
        ],
        "summary": "Records a payment for the app to track.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordPaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordPaymentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [ ]
      }
    }
  },
  "components": {
    "schemas": {
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer",
              "string"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer",
              "string"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "RecordPaymentRequest": {
        "required": [
          "customerReference",
          "subMerchantReference",
          "amount",
          "appPaymentReference"
        ],
        "type": "object",
        "properties": {
          "customerReference": {
            "type": "string"
          },
          "subMerchantReference": {
            "type": "string"
          },
          "amount": {
            "type": [
              "integer",
              "string"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int64"
          },
          "currencyCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "appPaymentReference": {
            "type": "string"
          }
        }
      },
      "RecordPaymentResponse": {
        "required": [
          "id",
          "appPaymentReference",
          "status",
          "amount",
          "currencyCode",
          "authorisedAmount",
          "responseCode",
          "clientMessage",
          "reversedAmount",
          "refundedAmount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "appPaymentReference": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "amount": {
            "type": [
              "integer",
              "string"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int64"
          },
          "currencyCode": {
            "type": "string"
          },
          "authorisedAmount": {
            "type": [
              "null",
              "integer",
              "string"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int64"
          },
          "responseCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "clientMessage": {
            "type": [
              "null",
              "string"
            ]
          },
          "reversedAmount": {
            "type": [
              "integer",
              "string"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int64"
          },
          "refundedAmount": {
            "type": [
              "integer",
              "string"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int64"
          }
        }
      }
    }
  }
}
