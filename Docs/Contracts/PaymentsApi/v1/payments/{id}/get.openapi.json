{
  "openapi": "3.1.1",
  "info": {
    "title": "Payments API",
    "version": "v1"
  },
  "paths": {
    "/v1/payments/{id}": {
      "get": {
        "tags": [
          "payments"
        ],
        "summary": "Returns a payment's current status.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPaymentResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [ ]
      }
    }
  },
  "components": {
    "schemas": {
      "GetPaymentResponse": {
        "required": [
          "id",
          "appPaymentReference",
          "status",
          "amount",
          "currencyCode",
          "authorisedAmount",
          "responseCode",
          "clientMessage",
          "reversedAmount",
          "refundedAmount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "appPaymentReference": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "amount": {
            "type": [
              "integer",
              "string"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int64"
          },
          "currencyCode": {
            "type": "string"
          },
          "authorisedAmount": {
            "type": [
              "null",
              "integer",
              "string"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int64"
          },
          "responseCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "clientMessage": {
            "type": [
              "null",
              "string"
            ]
          },
          "reversedAmount": {
            "type": [
              "integer",
              "string"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int64"
          },
          "refundedAmount": {
            "type": [
              "integer",
              "string"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int64"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer",
              "string"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      }
    }
  }
}
